    {slug==='pneumatics'&&<>
      <rect class="pv-main" x="58" y="78" width="145" height="72" rx="10"/>
      <rect class="pv-main" x="203" y="101" width="66" height="24" rx="4"/>
      <rect class="pv-cut" x="75" y="95" width="18" height="38" rx="3"/>
