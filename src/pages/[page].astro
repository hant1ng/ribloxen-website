---
import Base from '../layouts/Base.astro';
const pages={
'custom-parts':{title:'非标零件服务',en:'CUSTOM PARTS',desc:'从图纸和实际用途出发，确认材料、加工要求与验收条件，再对接适合的供应资源。',sections:[['可以从哪些零件开始','板类、支架、轴类、套类以及治具工装零件，可以按图纸逐项沟通。实际加工可行性与供货范围需评估确认。'],['把要求放在同一份清单里','提供有效版本图纸、材料牌号、数量、关键公差、表面处理和期望交期。首次试制与后续批量需求请分开说明。'],['先确认，再推进','收到需求后，核对图纸完整性与关键条件。工艺、价格、交期、检验资料和包装要求应在订单前明确。'],['图纸与保密','当前网站不接收图纸文件。请先整理需求摘要，待双方确认接收渠道与保密要求后再传递文件。']],faq:[['没有完整图纸，可以询价吗？','可以先描述用途并整理样件或尺寸信息。正式报价与加工仍需要确认明确、可执行的技术要求。'],['能保证特定精度和交期吗？','需要根据材料、结构、工艺、数量和验收条件评估。未经评估的精度或交期不能作为承诺。']]},
'solutions':{title:'采购解决方案',en:'PROCUREMENT SOLUTIONS',desc:'围绕采购清单、非标需求和备件补充，减少信息遗漏，让每一项需求可以被核对。',sections:[['设备配套采购','将同一项目的标准件按类别、型号、数量和期望交期整理。对于跨品类需求，逐项核实供应条件与可接受的替代范围。'],['非标与标准件协同','将需要按图沟通的零件与标准型号分开列示，在同一项目中分别确认技术要求、报价与交付节点。'],['备件与替代需求','保留原部件完整型号、铭牌、安装尺寸和设备工况。停产或缺货型号可沟通替代方向，具体方案由使用方确认适用性。']],faq:[['一张清单可以包含多种产品吗？','可以。建议每行写清名称、品牌、完整型号、数量和单位，并标记是否允许替代。'],['可以先询问其中几项吗？','可以。优先整理影响设备进度的项目，并说明期望交付日期。']]},
'industries':{title:'应用行业',en:'APPLICATIONS',desc:'服务沟通围绕零部件和设备需求展开。以下为可对接的应用场景，不代表已完成的客户案例。',sections:[['非标自动化设备','装配、搬运、定位与检测设备中的运动、连接和结构零件需求。'],['包装与通用机械','传动、导向、气动和设备调节部件的选型与采购沟通。'],['电子装配与工装治具','定位销、支架、夹紧件以及按图沟通的治具零件。'],['工厂设备维护','按原型号和工况整理备件更换需求，对替代条件逐项核实。']],faq:[]},
'capabilities':{title:'服务与交付',en:'SERVICE & DELIVERY',desc:'用清晰的需求、可核对的规格和提前约定的验收条件，建立采购协作。',sections:[['需求核对','检查型号是否完整、图纸版本是否一致、数量与单位是否明确。对于缺失信息，先列明再确认。'],['供应资源对接','依据已确认的需求对接相应资源。供货品牌、加工方式与实际供应能力需逐项核实。'],['商务条件确认','报价应明确价格、税费口径、运费、交期、付款条件及有效期。以双方确认的订单或合同为准。'],['交付与反馈','按约定跟进进度，核对数量和资料。到货异常应保留产品标识、照片与相关记录，以便对照订单处理。']],faq:[['是否有自有工厂或自有仓库？','本网站不作未经核实的自有工厂、仓储或设备能力声明。具体产品的供应方式可在询价时确认。']]},
'about':{title:'关于日不落自动化',en:'ABOUT RIBLOXEN',desc:'RIBLOXEN 是昆山日不落自动化设备有限公司的品牌表达，聚焦自动化标准零部件与非标零件需求。',sections:[['连接需求与供应','从一份型号清单、一张图纸要求或一个设备问题开始，协助整理采购信息，对接零部件供应资源。'],['面向设备采购的实际工作','希望与非标自动化设备厂、系统集成商、机械设备制造商及工厂维护团队建立清晰、持续的采购沟通。'],['把信息说清楚','具体供货范围、规格、价格、交期与验收条件，在需求核实后确认。对无法确认的信息保留说明，避免把展示内容当作供货承诺。']],faq:[]},
'contact':{title:'联系我们',en:'CONTACT',desc:'把你的需求整理清楚，是合作的第一步。可以先在询价页生成采购清单。',sections:[['昆山日不落自动化设备有限公司','品牌：RIBLOXEN\n所在地：中国 · 昆山\n官网域名：ribloxen.com'],['询价准备','标准件请提供名称、完整型号与数量；非标件请整理材料、图纸版本、数量及关键要求。'],['联系方式正在完善','公开电话、邮箱和微信尚未配置。当前请使用询价页整理并下载需求清单。在线提交是否可用，以询价页实时提示为准。']],faq:[]},
'privacy':{title:'隐私说明',en:'PRIVACY',desc:'以下说明本网站询价功能的数据使用方式与当前限制。',sections:[['询价信息','当在线接收功能启用时，表单收集你主动填写的联系人、联系方式、公司及需求摘要，用于处理询价和后续业务沟通。未勾选同意时不会提交。请勿填写与询价无关的个人信息。'],['保存与传递','仅在页面明确提示提交成功时，询价才已由服务端保存。下载清单在你的浏览器内生成；点击下载不会向服务器提交表单内容。当前不接收图纸附件。'],['访问与防滥用','网站托管于 Cloudflare。基础访问可能由托管服务处理网络信息。表单通过同源校验、大小限制与短期频率限制防止滥用，频率限制使用 IP 地址的加盐摘要，过期记录随后续请求清理。本站不设置营销追踪代码。'],['保留与联系','询价仅限授权人员处理。接收功能启用前，运营方需配置有效联系渠道与数据保留期限；到期询价随接收请求清理。对于访问、更正或删除请求，请通过联系页面公示的渠道提出。'],['当前运行状态','公开联系方式尚未配置。在完成联系渠道和保留期限配置前，服务器拒绝接收询价。隐私说明会随实际功能调整。']],faq:[]}
};
export function getStaticPaths(){return ['custom-parts','solutions','industries','capabilities','about','contact','privacy'].map(page=>({params:{page}}));}
const page=Astro.params.page as keyof typeof pages;const data=structuredClone(pages[page]);
const email=import.meta.env.PUBLIC_CONTACT_EMAIL;
if(email&&/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)){if(page==='contact'){data.sections[2]=['联系邮箱',email+'\n可通过此邮箱沟通询价事项。请在另行确认接收方式后传递敏感图纸。'];}if(page==='privacy'){data.sections[4]=['联系与当前功能','隐私相关请求请通过 '+email+' 提出。在线询价接收状态以询价页实时提示为准。'];}}
---
<Base title={data.title} description={data.desc} crumbs={[{name:data.title,url:`/${page}/`}]}><section class="page-intro"><div class="wrap"><p class="eyebrow">{data.en}</p><h1>{data.title}</h1><p>{data.desc}</p></div></section><section class="section"><div class="wrap split"><div><div class="prose">{data.sections.map(([h,p])=><section><h2>{h}</h2><p style="white-space:pre-line">{p}</p></section>)}</div>{data.faq.length>0&&<div class="faq"><h2 style="margin-top:40px">常见问题</h2>{data.faq.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</div>}</div><aside><div class="service" style="background:var(--pale)"><p class="eyebrow">NEXT STEP</p><h2>从具体需求开始</h2><p>已知型号、图纸要求或需要解决的问题，都可以整理成一份清单。</p><a class="button" href="/rfq/">整理询价需求 ↗</a><a class="text-link" href="/products/">查看产品中心 ↗</a></div></aside></div></section></Base>
