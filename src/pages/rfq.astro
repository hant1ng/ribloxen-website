---
import Base from '../layouts/Base.astro';
import {site} from '../data/site';
import Icon from '../components/Icon.astro';
---
<Base title="联系询价：整理标准件与非标件采购需求" description="整理自动化标准件型号、非标零件要求、数量和交期，下载询价清单并通过企业邮箱或电话联系 RIBLOXEN。" crumbs={[{name:'联系询价',url:'/rfq/'}]}>
<section class="page-intro"><div class="wrap"><p class="eyebrow">REQUEST FOR QUOTATION</p><h1>把需求整理清楚，再开始报价沟通。</h1><p>在线提交暂未启用。可以在本页生成询价清单，再发送到企业邮箱，或直接电话联系。</p></div></section>
<section class="section"><div class="wrap split">
<form id="rfq-form" data-email={site.contact.email}>
  <div class="notice">当前不会把表单内容提交到服务器。下载询价清单后，请发送至 <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>，或联系 {site.contact.name}：<a href={`tel:${site.contact.phone}`}>{site.contact.phone}</a>。</div>
  <div class="form-grid">
    <label>需求类型<select name="type"><option value="standard">标准件采购</option><option value="custom">非标零件</option><option value="mixed">综合采购</option></select></label>
    <label>公司名称<input name="company" maxlength="120" autocomplete="organization"/></label>
    <label>联系人 <span aria-hidden="true">*</span><input name="name" required maxlength="60" autocomplete="name"/></label>
    <label>手机或邮箱 <span aria-hidden="true">*</span><input name="contact" required maxlength="150" autocomplete="off"/></label>
    <label class="full">产品名称或型号<input name="product" maxlength="200" placeholder="可填写多个名称或型号"/></label>
    <label>数量与单位<input name="quantity" maxlength="100" placeholder="例如：10 件、2 套"/></label>
    <label>期望到货日期<input type="date" name="date"/></label>
    <label class="full">需求说明 <span aria-hidden="true">*</span><textarea name="details" rows="6" required minlength="5" maxlength="5000" placeholder="标准件：型号、规格、是否允许替代。非标件：材质、图纸版本、公差、表面处理及数量。"></textarea></label>
  </div>
  <div class="actions">
    <button class="button" type="button" id="download-rfq">下载询价清单 <Icon name="download" /></button>
    <a class="button secondary" href={`mailto:${site.contact.email}?subject=RIBLOXEN%20询价`}>发送邮件 <Icon /></a>
  </div>
  <div class="form-status" id="form-status" role="status" aria-live="polite"></div>
</form>
<aside>
  <div class="service" style="background:var(--pale)">
    <p class="eyebrow">CONTACT</p>
    <h2>{site.contact.name}</h2>
    <p><a href={`tel:${site.contact.phone}`}>{site.contact.phone}</a><br/><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></p>
    <h3>询价前建议准备</h3>
    <ul><li>品牌和完整型号后缀</li><li>数量与单位</li><li>非标件图纸版本</li><li>是否接受替代型号</li><li>期望到货时间</li></ul>
    <p class="notice">当前不支持附件上传。敏感图纸请先确认接收渠道及保密要求。</p>
    <a class="text-link" href="/knowledge/rfq-checklist/">查看询价准备指南 <Icon /></a>
  </div>
</aside>
</div></section>
<script>
const form=document.querySelector<HTMLFormElement>('#rfq-form')!;
const status=document.querySelector<HTMLElement>('#form-status')!;const contactEmail=form.dataset.email||'';
const params=new URLSearchParams(location.search);
const product=form.elements.namedItem('product') as HTMLInputElement;
if(params.get('product')) product.value=params.get('product')!.slice(0,200);
const type=form.elements.namedItem('type') as HTMLSelectElement;
if(['standard','custom','mixed'].includes(params.get('type')||'')) type.value=params.get('type')!;
function values(){return Object.fromEntries(new FormData(form).entries());}
document.querySelector('#download-rfq')?.addEventListener('click',()=>{
  if(!form.reportValidity()) return;
  const v=values();
  const types={standard:'标准件采购',custom:'非标零件',mixed:'综合采购'};
  const body=[
    'RIBLOXEN 询价清单',
    `请将此文件发送至 ${contactEmail}`,
    `生成日期：${new Date().toLocaleDateString('zh-CN')}`,
    `类型：${types[v.type as keyof typeof types]}`,
    `公司：${v.company||''}`,
    `联系人：${v.name||''}`,
    `联系方式：${v.contact||''}`,
    `产品：${v.product||''}`,
    `数量：${v.quantity||''}`,
    `期望到货：${v.date||''}`,
    '需求说明：',
    String(v.details||'')
  ].join('\n');
  const url=URL.createObjectURL(new Blob(['\ufeff'+body],{type:'text/plain;charset=utf-8'}));
  const a=document.createElement('a');
  a.href=url;
  a.download='RIBLOXEN-询价清单.txt';
  a.click();
  URL.revokeObjectURL(url);
  status.textContent='询价清单已下载。请通过企业邮箱发送给我们，下载本身不会提交任何数据。';
});
</script>
</Base>
