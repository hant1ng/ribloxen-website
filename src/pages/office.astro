---
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/>
  <meta name="robots" content="noindex,nofollow,noarchive"/>
  <meta name="theme-color" content="#0b1522"/>
  <title>RIBLOXEN 报价库</title>
  <style>
    :root{font-family:Arial,"PingFang SC","Microsoft YaHei",sans-serif;color:#172333;background:#f3f6f8;--blue:#005bac;--deep:#0b1522;--line:#dbe3e8;--muted:#6c7a89;--card:#fff;--soft:#f5f8fa;--danger:#b42318}
    *{box-sizing:border-box}html,body{margin:0;min-height:100%;background:#f3f6f8}button,input,textarea,select{font:inherit}button{cursor:pointer}a{color:inherit}
    [hidden]{display:none!important}.shell{min-height:100vh}.topbar{position:sticky;top:0;z-index:30;background:var(--deep);color:#fff;border-bottom:1px solid #ffffff1a}.topbar-inner{max-width:1180px;margin:auto;padding:14px 20px;display:flex;align-items:center;justify-content:space-between;gap:18px}.brand{font-weight:900;letter-spacing:-.04em;font-size:22px}.brand small{display:block;margin-top:3px;font-size:9px;letter-spacing:.14em;font-weight:600;color:#93a4b7}.top-actions{display:flex;gap:8px;align-items:center}.ghost{background:transparent;color:inherit;border:1px solid #ffffff33;padding:9px 12px}.main{max-width:1180px;margin:auto;padding:24px 20px 80px}.search-card{background:var(--card);border:1px solid var(--line);padding:20px}.search-title{font-size:12px;color:var(--blue);font-weight:800;letter-spacing:.12em;margin-bottom:10px}.search-row{display:grid;grid-template-columns:1fr auto;gap:10px}.search-row input{width:100%;border:1px solid #b9c6cf;padding:15px 16px;font-size:17px;background:#fff}.primary{border:1px solid var(--blue);background:var(--blue);color:#fff;padding:12px 17px;font-weight:700}.primary:hover{background:#00467f}.secondary{border:1px solid var(--line);background:#fff;color:#26384a;padding:12px 15px;font-weight:700}.secondary:hover{border-color:#9db0be}.danger{color:#fff;background:var(--danger);border:1px solid var(--danger)}
    .quick-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}.counts{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin:14px 0 20px}.count{background:#fff;border:1px solid var(--line);padding:15px}.count b{font-size:24px;display:block}.count span{font-size:11px;color:var(--muted)}.section-title{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:24px 0 10px}.section-title h2{font-size:17px;margin:0}.section-title span{font-size:12px;color:var(--muted)}
    .results{display:grid;gap:8px}.result{width:100%;text-align:left;background:#fff;border:1px solid var(--line);padding:16px;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:14px;align-items:center}.result:hover{border-color:#8fb5d3}.result strong{display:block;font-size:17px;letter-spacing:.01em}.result small{display:block;color:var(--muted);margin-top:6px;line-height:1.5}.prices{text-align:right;display:grid;gap:3px;font-size:12px;color:var(--muted)}.prices b{color:#23374a}.empty{padding:32px 20px;text-align:center;background:#fff;border:1px dashed #bac7d0;color:var(--muted)}
    .detail{margin-top:20px}.detail-head{background:var(--deep);color:#fff;padding:20px;display:flex;justify-content:space-between;gap:20px;align-items:flex-start}.detail-head h1{font-size:25px;margin:0 0 8px;word-break:break-all}.detail-head p{margin:0;color:#b8c5d1;font-size:13px}.detail-actions{display:flex;gap:7px;flex-wrap:wrap;justify-content:flex-end}.detail-actions button{white-space:nowrap}.summary{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);border:1px solid var(--line);border-top:0}.metric{background:#fff;padding:16px}.metric span{display:block;color:var(--muted);font-size:11px;margin-bottom:7px}.metric b{font-size:20px}.detail-grid{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(250px,.7fr);gap:14px;margin-top:14px}.panel{background:#fff;border:1px solid var(--line);padding:18px}.panel h3{font-size:15px;margin:0 0 14px}.facts{display:grid;grid-template-columns:120px 1fr;font-size:13px}.facts dt,.facts dd{padding:9px 0;border-top:1px solid #edf1f3;margin:0}.facts dt{color:var(--muted)}.facts dd{white-space:pre-wrap;word-break:break-word}.quote-box{display:grid;gap:10px}.quote-box label{font-size:12px;color:var(--muted)}.quote-box input{width:100%;margin-top:5px;border:1px solid #c3cdd5;padding:10px}.quote-output{padding:14px;background:#f1f6fa;border-left:3px solid var(--blue)}.quote-output b{font-size:24px;color:var(--blue)}.quote-output small{display:block;color:var(--muted);margin-top:5px}
    .history{margin-top:14px;background:#fff;border:1px solid var(--line)}.tabs{display:flex;overflow:auto;border-bottom:1px solid var(--line)}.tab{border:0;border-right:1px solid var(--line);background:#fff;padding:13px 16px;white-space:nowrap;color:#526272}.tab.active{color:var(--blue);font-weight:800;border-bottom:2px solid var(--blue)}.table-wrap{overflow:auto}.table{width:100%;border-collapse:collapse;min-width:760px}.table th,.table td{padding:12px 14px;border-bottom:1px solid #edf1f3;text-align:left;font-size:12px;vertical-align:top}.table th{background:#f7f9fa;color:#5f6f7f;font-weight:700}.table td strong{font-size:13px}.tag{display:inline-block;padding:3px 6px;background:#eef3f6;color:#526575;font-size:10px;margin-right:4px}.positive{color:#147d42}.negative{color:#b42318}
    dialog{border:0;padding:0;width:min(680px,calc(100% - 24px));max-height:90vh;box-shadow:0 24px 80px #0005}dialog::backdrop{background:#08111cc4}.dialog-head{display:flex;justify-content:space-between;align-items:center;padding:17px 20px;background:var(--deep);color:#fff}.dialog-head h2{font-size:18px;margin:0}.dialog-head button{background:transparent;border:0;color:#fff;font-size:22px}.dialog-body{padding:20px;overflow:auto;max-height:calc(90vh - 58px)}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.form-grid label{font-size:12px;font-weight:700;color:#526272}.form-grid input,.form-grid textarea,.form-grid select{width:100%;margin-top:6px;border:1px solid #b9c6cf;padding:11px;background:#fff;color:#172333}.form-grid textarea{min-height:92px;resize:vertical}.full{grid-column:1/-1}.checks{display:flex;gap:20px;align-items:center;flex-wrap:wrap}.checks label{display:flex;gap:7px;align-items:center;font-weight:500}.checks input{width:auto;margin:0}.form-footer{display:flex;justify-content:flex-end;gap:8px;margin-top:18px;padding-top:16px;border-top:1px solid var(--line)}.form-status{min-height:18px;margin-top:10px;font-size:12px;color:var(--danger)}
    .login-wrap{min-height:100vh;display:grid;place-items:center;padding:20px;background:var(--deep)}.login-card{width:min(420px,100%);background:#fff;padding:28px;border-top:4px solid var(--blue)}.login-card h1{margin:0 0 8px;font-size:27px}.login-card p{font-size:13px;line-height:1.7;color:var(--muted)}.login-card input{width:100%;padding:13px;border:1px solid #aebbc5;margin:10px 0}.login-card button{width:100%}.setup-note{padding:14px;background:#fff5e8;color:#7a4b00;font-size:12px;line-height:1.65;margin-top:14px}.toast{position:fixed;right:18px;bottom:18px;z-index:80;background:#102131;color:#fff;padding:13px 16px;box-shadow:0 8px 30px #0003;font-size:13px;max-width:320px}
    @media(max-width:800px){.main{padding:16px 12px 70px}.topbar-inner{padding:12px}.counts{grid-template-columns:repeat(3,1fr)}.detail-grid{grid-template-columns:1fr}.summary{grid-template-columns:repeat(2,1fr)}.detail-head{display:block}.detail-actions{justify-content:flex-start;margin-top:15px}.facts{grid-template-columns:92px 1fr}.form-grid{grid-template-columns:1fr}.full{grid-column:auto}.result{grid-template-columns:1fr}.prices{text-align:left;grid-template-columns:repeat(3,auto);justify-content:start;gap:10px}.search-card{padding:14px}}
    @media(max-width:480px){.brand{font-size:20px}.top-actions .ghost{padding:8px 10px}.search-row{grid-template-columns:1fr}.search-row button{width:100%}.quick-actions{display:grid;grid-template-columns:1fr 1fr}.counts{grid-template-columns:repeat(2,1fr)}.count:last-child{grid-column:1/-1}.detail-head h1{font-size:22px}.summary{grid-template-columns:1fr 1fr}.metric b{font-size:17px}.detail-actions{display:grid;grid-template-columns:1fr 1fr}.detail-actions button{padding:10px}.panel{padding:15px}.dialog-body{padding:15px}.form-footer{display:grid;grid-template-columns:1fr 1fr}.form-footer button{width:100%}}
  </style>
</head>
<body>
<div id="loginView" class="login-wrap" hidden>
  <form id="loginForm" class="login-card">
    <div class="brand">RIBLOXEN<small>INTERNAL QUOTE DESK</small></div>
    <h1>内部报价库</h1>
    <p>用于物料参数、供应渠道、历史采购价和客户报价记录。数据只保存在你的 Cloudflare D1。</p>
    <label>访问密码
      <input id="password" type="password" autocomplete="current-password" required/>
    </label>
    <button class="primary" type="submit">进入报价库</button>
    <div id="loginStatus" class="form-status"></div>
    <div id="setupNote" class="setup-note" hidden>后台安全变量还没配置。需要在 Cloudflare Pages 项目中新增一个至少 12 位的加密变量 OFFICE_PASSWORD，然后重新部署一次。</div>
  </form>
</div>

<div id="appView" class="shell" hidden>
  <header class="topbar">
    <div class="topbar-inner">
      <div class="brand">RIBLOXEN<small>INTERNAL QUOTE DESK</small></div>
      <div class="top-actions"><button id="logoutBtn" class="ghost" type="button">退出</button></div>
    </div>
  </header>

  <main class="main">
    <section class="search-card">
      <div class="search-title">MATERIAL SEARCH</div>
      <div class="search-row">
        <input id="searchInput" type="search" placeholder="输入料号、品牌、名称、替代型号…" autocomplete="off"/>
        <button id="searchBtn" class="primary" type="button">查物料</button>
      </div>
      <div class="quick-actions">
        <button class="secondary" type="button" data-open="materialDialog">＋ 新增物料</button>
        <button class="secondary" type="button" data-open="supplierDialog">＋ 供应商</button>
        <button class="secondary" type="button" data-open="customerDialog">＋ 客户</button>
      </div>
    </section>

    <section id="counts" class="counts"></section>

    <div id="listArea">
      <div class="section-title"><h2 id="listTitle">最近物料</h2><span id="listHint">按最近活动排序</span></div>
      <div id="results" class="results"></div>
    </div>

    <section id="detailArea" class="detail" hidden>
      <div class="detail-head">
        <div><h1 id="detailPart"></h1><p id="detailMeta"></p></div>
        <div class="detail-actions">
          <button class="ghost" type="button" id="backBtn">← 返回搜索</button>
          <button class="ghost" type="button" id="editMaterialBtn">编辑参数</button>
          <button class="ghost" type="button" data-open-record="supplierQuoteDialog">＋ 供应报价</button>
          <button class="ghost" type="button" data-open-record="purchaseDialog">＋ 采购</button>
          <button class="primary" type="button" data-open-record="saleDialog">＋ 客户报价</button>
        </div>
      </div>
      <div id="summary" class="summary"></div>
      <div class="detail-grid">
        <div class="panel">
          <h3>物料资料</h3>
          <dl id="materialFacts" class="facts"></dl>
        </div>
        <div class="panel">
          <h3>快速报价参考</h3>
          <div class="quote-box">
            <label>参考成本
              <input id="calcCost" type="number" step="0.0001" min="0"/>
            </label>
            <label>目标毛利率 %
              <input id="calcMargin" type="number" step="1" min="0" max="95" value="30"/>
            </label>
            <div class="quote-output"><b id="calcPrice">¥0.00</b><small id="calcHint">根据最近采购或供应商报价计算</small></div>
            <button id="copyQuoteBtn" class="secondary" type="button">复制报价参考</button>
          </div>
        </div>
      </div>
      <div class="history">
        <div class="tabs">
          <button class="tab active" type="button" data-tab="supplierQuotes">供应商报价</button>
          <button class="tab" type="button" data-tab="purchases">采购历史</button>
          <button class="tab" type="button" data-tab="sales">销售报价</button>
        </div>
        <div id="historyTable" class="table-wrap"></div>
      </div>
    </section>
  </main>
</div>

<dialog id="materialDialog">
  <div class="dialog-head"><h2 id="materialDialogTitle">新增物料</h2><button type="button" data-close>×</button></div>
  <div class="dialog-body">
    <form id="materialForm">
      <input type="hidden" name="id"/>
      <div class="form-grid">
        <label>料号 *<input name="part_number" required maxlength="120"/></label>
        <label>品牌<input name="brand" maxlength="100"/></label>
        <label>名称<input name="name" maxlength="160"/></label>
        <label>分类<input name="category" maxlength="120"/></label>
        <label class="full">参数<textarea name="specs" placeholder="例如：轴径 6mm&#10;长度 30mm&#10;材质 SUS304"></textarea></label>
        <label class="full">别名 / 搜索词<input name="aliases" placeholder="多个词可用空格或逗号分隔"/></label>
        <label class="full">替代型号<input name="alternatives"/></label>
        <label class="full">来源链接<input name="source_url" inputmode="url"/></label>
        <label class="full">备注<textarea name="notes"></textarea></label>
      </div>
      <div class="form-status"></div>
      <div class="form-footer"><button class="secondary" type="button" data-close>取消</button><button class="primary" type="submit">保存物料</button></div>
    </form>
  </div>
</dialog>

<dialog id="supplierDialog">
  <div class="dialog-head"><h2>新增供应商 / 渠道</h2><button type="button" data-close>×</button></div>
  <div class="dialog-body">
    <form id="supplierForm">
      <div class="form-grid">
        <label class="full">供应商或渠道名称 *<input name="name" required/></label>
        <label>联系人<input name="contact_name"/></label>
        <label>渠道类型<select name="channel_type"><option value="">请选择</option><option>厂家</option><option>代理商</option><option>贸易商</option><option>1688</option><option>淘宝/天猫</option><option>京东</option><option>其他</option></select></label>
        <label>电话<input name="phone" inputmode="tel"/></label>
        <label>微信<input name="wechat"/></label>
        <label class="full">链接<input name="link" inputmode="url"/></label>
        <label class="full">备注<textarea name="notes"></textarea></label>
      </div>
      <div class="form-status"></div>
      <div class="form-footer"><button class="secondary" type="button" data-close>取消</button><button class="primary" type="submit">保存供应商</button></div>
    </form>
  </div>
</dialog>

<dialog id="customerDialog">
  <div class="dialog-head"><h2>新增客户</h2><button type="button" data-close>×</button></div>
  <div class="dialog-body">
    <form id="customerForm">
      <div class="form-grid">
        <label class="full">客户名称 *<input name="name" required/></label>
        <label>联系人<input name="contact_name"/></label>
        <label>电话<input name="phone" inputmode="tel"/></label>
        <label>微信<input name="wechat"/></label>
        <label class="full">备注<textarea name="notes"></textarea></label>
      </div>
      <div class="form-status"></div>
      <div class="form-footer"><button class="secondary" type="button" data-close>取消</button><button class="primary" type="submit">保存客户</button></div>
    </form>
  </div>
</dialog>

<dialog id="supplierQuoteDialog">
  <div class="dialog-head"><h2>记录供应商报价</h2><button type="button" data-close>×</button></div>
  <div class="dialog-body">
    <form id="supplierQuoteForm">
      <input type="hidden" name="material_id"/>
      <div class="form-grid">
        <label class="full">供应商 *<select name="supplier_id" required></select></label>
        <label>数量<input name="quantity" type="number" step="0.01" min="0.01" value="1" required/></label>
        <label>单价 ¥ *<input name="unit_price" type="number" step="0.0001" min="0" required/></label>
        <label>询价日期<input name="quoted_at" type="date"/></label>
        <label>有效期<input name="valid_until" type="date"/></label>
        <label>交期<input name="lead_time" placeholder="例如 3天 / 现货"/></label>
        <label>来源<input name="source" placeholder="微信 / 电话 / 1688"/></label>
        <div class="full checks"><label><input type="checkbox" name="tax_included"/>含税</label><label><input type="checkbox" name="shipping_included"/>含运</label></div>
        <label class="full">备注<textarea name="notes"></textarea></label>
      </div>
      <div class="form-status"></div>
      <div class="form-footer"><button class="secondary" type="button" data-close>取消</button><button class="primary" type="submit">保存报价</button></div>
    </form>
  </div>
</dialog>

<dialog id="purchaseDialog">
  <div class="dialog-head"><h2>记录实际采购</h2><button type="button" data-close>×</button></div>
  <div class="dialog-body">
    <form id="purchaseForm">
      <input type="hidden" name="material_id"/>
      <div class="form-grid">
        <label class="full">供应商 *<select name="supplier_id" required></select></label>
        <label>数量<input name="quantity" type="number" step="0.01" min="0.01" value="1" required/></label>
        <label>采购单价 ¥ *<input name="unit_price" type="number" step="0.0001" min="0" required/></label>
        <label>采购日期<input name="purchased_at" type="date"/></label>
        <label>关联客户<select name="customer_id"></select></label>
        <label class="full">订单号 / 参考号<input name="order_ref"/></label>
        <div class="full checks"><label><input type="checkbox" name="tax_included"/>含税</label><label><input type="checkbox" name="shipping_included"/>含运</label></div>
        <label class="full">备注<textarea name="notes"></textarea></label>
      </div>
      <div class="form-status"></div>
      <div class="form-footer"><button class="secondary" type="button" data-close>取消</button><button class="primary" type="submit">保存采购记录</button></div>
    </form>
  </div>
</dialog>

<dialog id="saleDialog">
  <div class="dialog-head"><h2>记录客户报价 / 成交</h2><button type="button" data-close>×</button></div>
  <div class="dialog-body">
    <form id="saleForm">
      <input type="hidden" name="material_id"/>
      <div class="form-grid">
        <label class="full">客户<select name="customer_id"></select></label>
        <label>数量<input name="quantity" type="number" step="0.01" min="0.01" value="1" required/></label>
        <label>销售单价 ¥ *<input name="unit_price" type="number" step="0.0001" min="0" required/></label>
        <label>当时成本 ¥<input name="cost_unit_price" type="number" step="0.0001" min="0"/></label>
        <label>状态<select name="status"><option value="quoted">已报价</option><option value="won">已成交</option><option value="lost">未成交</option></select></label>
        <label>报价日期<input name="quoted_at" type="date"/></label>
        <label>订单号 / 参考号<input name="order_ref"/></label>
        <div class="full checks"><label><input type="checkbox" name="tax_included"/>含税</label><label><input type="checkbox" name="shipping_included"/>含运</label></div>
        <label class="full">备注<textarea name="notes"></textarea></label>
      </div>
      <div class="form-status"></div>
      <div class="form-footer"><button class="secondary" type="button" data-close>取消</button><button class="primary" type="submit">保存销售记录</button></div>
    </form>
  </div>
</dialog>

<div id="toast" class="toast" hidden></div>

<script is:inline>
(() => {
  const $ = (s, root=document) => root.querySelector(s);
  const $$ = (s, root=document) => [...root.querySelectorAll(s)];
  const loginView = $('#loginView');
  const appView = $('#appView');
  const resultsEl = $('#results');
  const detailArea = $('#detailArea');
  let current = null;
  let suppliers = [];
  let customers = [];
  let activeTab = 'supplierQuotes';
  let searchTimer = null;

  const esc = value => String(value ?? '').replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
  const money = value => value === null || value === undefined || value === '' ? '—' : '¥' + Number(value).toLocaleString('zh-CN',{minimumFractionDigits:2,maximumFractionDigits:4});
  const date = value => value ? new Date(Number(value)).toLocaleDateString('zh-CN') : '—';
  const today = () => new Date().toISOString().slice(0,10);
  const toast = message => { const el=$('#toast'); el.textContent=message; el.hidden=false; clearTimeout(el._timer); el._timer=setTimeout(()=>el.hidden=true,2300); };

  async function api(path, options={}) {
    const config = { credentials:'same-origin', ...options };
    if (config.body && typeof config.body !== 'string') {
      config.headers = { 'Content-Type':'application/json', ...(config.headers||{}) };
      config.body = JSON.stringify(config.body);
    }
    const res = await fetch('/api/office/' + path, config);
    let data={};
    try { data=await res.json(); } catch {}
    if (res.status===401 && path!=='login') {
      showLogin();
      throw new Error(data.message || '请先登录');
    }
    if (!res.ok) throw new Error(data.message || '操作失败');
    return data;
  }

  function showLogin(setup=false) {
    appView.hidden=true; loginView.hidden=false; $('#setupNote').hidden=!setup;
  }
  function showApp() { loginView.hidden=true; appView.hidden=false; }

  async function boot() {
    try {
      const status=await api('status');
      if (!status.ready) return showLogin(true);
      if (!status.authenticated) return showLogin(false);
      showApp();
      await Promise.all([loadDashboard(), loadLookups()]);
      await search('');
    } catch { showLogin(false); }
  }

  $('#loginForm').addEventListener('submit', async e => {
    e.preventDefault();
    const status=$('#loginStatus'); status.textContent='';
    try {
      await api('login',{method:'POST',body:{password:$('#password').value}});
      $('#password').value='';
      showApp();
      await Promise.all([loadDashboard(),loadLookups()]);
      await search('');
    } catch(err) { status.textContent=err.message; }
  });

  $('#logoutBtn').addEventListener('click', async () => {
    try { await api('logout',{method:'POST',body:{}}); } catch {}
    current=null; showLogin(false);
  });

  async function loadDashboard() {
    const data=await api('dashboard');
    const c=data.counts;
    $('#counts').innerHTML=[
      ['物料',c.materials],['供应渠道',c.suppliers],['历史询价',c.supplierQuotes],['采购记录',c.purchases],['销售报价',c.sales]
    ].map(x=>'<div class="count"><b>'+esc(x[1])+'</b><span>'+esc(x[0])+'</span></div>').join('');
  }

  async function loadLookups() {
    const [s,c]=await Promise.all([api('suppliers'),api('customers')]);
    suppliers=s.results||[]; customers=c.results||[];
    refillSelects();
  }

  function refillSelects() {
    $$('select[name="supplier_id"]').forEach(sel => {
      const currentValue=sel.value;
      sel.innerHTML='<option value="">请选择供应商</option>'+suppliers.map(x=>'<option value="'+esc(x.id)+'">'+esc(x.name)+(x.channel_type?' · '+esc(x.channel_type):'')+'</option>').join('');
      if(currentValue) sel.value=currentValue;
    });
    $$('select[name="customer_id"]').forEach(sel => {
      const currentValue=sel.value;
      sel.innerHTML='<option value="">不关联客户</option>'+customers.map(x=>'<option value="'+esc(x.id)+'">'+esc(x.name)+'</option>').join('');
      if(currentValue) sel.value=currentValue;
    });
  }

  async function search(q) {
    try {
      const data=await api('materials?q='+encodeURIComponent(q||''));
      renderResults(data.results||[],q);
    } catch(err) { resultsEl.innerHTML='<div class="empty">'+esc(err.message)+'</div>'; }
  }

  function renderResults(rows,q) {
    $('#listTitle').textContent=q?'搜索结果':'最近物料';
    $('#listHint').textContent=q?rows.length+' 条':'按最近编辑和交易排序';
    if(!rows.length){resultsEl.innerHTML='<div class="empty">'+(q?'没有找到这个物料，可以直接新增。':'还没有物料，先录入第一个料号。')+'</div>';return;}
    resultsEl.innerHTML=rows.map(r=>'<button class="result" type="button" data-id="'+esc(r.id)+'"><span><strong>'+esc(r.part_number)+'</strong><small>'+esc([r.brand,r.name,r.category].filter(Boolean).join(' · ')||'暂无名称和分类')+'</small></span><span class="prices"><span>询价 <b>'+money(r.latest_supplier_price)+'</b></span><span>采购 <b>'+money(r.latest_purchase_price)+'</b></span><span>销售 <b>'+money(r.latest_sale_price)+'</b></span></span></button>').join('');
    $$('.result',resultsEl).forEach(btn=>btn.addEventListener('click',()=>openMaterial(btn.dataset.id)));
  }

  $('#searchBtn').addEventListener('click',()=>search($('#searchInput').value.trim()));
  $('#searchInput').addEventListener('input',e=>{
    clearTimeout(searchTimer);
    searchTimer=setTimeout(()=>search(e.target.value.trim()),260);
  });
  $('#searchInput').addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();search(e.target.value.trim());}});

  async function openMaterial(id) {
    const data=await api('materials/'+encodeURIComponent(id));
    current=data;
    renderDetail();
    detailArea.hidden=false;
    $('#listArea').hidden=true;
    detailArea.scrollIntoView({behavior:'smooth',block:'start'});
  }

  function latestCost() {
    if(!current) return null;
    const p=current.purchases?.[0]||null;
    const q=current.supplierQuotes?.[0]||null;
    if(!p&&!q)return null;
    if(!p)return Number(q.unit_price);
    if(!q)return Number(p.unit_price);
    return Number(Number(p.purchased_at)>=Number(q.quoted_at)?p.unit_price:q.unit_price);
  }

  function renderDetail() {
    const m=current.material;
    $('#detailPart').textContent=m.part_number;
    $('#detailMeta').textContent=[m.brand,m.name,m.category].filter(Boolean).join(' · ') || '暂无补充信息';
    const purchases=current.purchases||[], quotes=current.supplierQuotes||[], sales=current.sales||[];
    const cost=latestCost();
    const lowest=[...quotes,...purchases].map(x=>Number(x.unit_price)).filter(Number.isFinite).reduce((a,b)=>Math.min(a,b),Infinity);
    const latestSale=sales[0]?.unit_price!==undefined?Number(sales[0].unit_price):null;
    const margin=latestSale&&cost!==null&&latestSale>0 ? (latestSale-cost)/latestSale*100 : null;
    $('#summary').innerHTML=[
      ['最近成本',money(cost)],
      ['历史低价',Number.isFinite(lowest)?money(lowest):'—'],
      ['最近销售价',money(latestSale)],
      ['参考毛利',margin===null?'—':margin.toFixed(1)+'%']
    ].map(x=>'<div class="metric"><span>'+esc(x[0])+'</span><b>'+esc(x[1])+'</b></div>').join('');
    const facts=[
      ['品牌',m.brand],['名称',m.name],['分类',m.category],['参数',m.specs],['别名',m.aliases],['替代型号',m.alternatives],['来源',m.source_url],['备注',m.notes]
    ].filter(x=>x[1]);
    $('#materialFacts').innerHTML=facts.length?facts.map(x=>'<dt>'+esc(x[0])+'</dt><dd>'+esc(x[1])+'</dd>').join(''):'<dt>资料</dt><dd>还没有补充参数。</dd>';
    $('#calcCost').value=cost===null?'':String(cost);
    updateCalculator();
    renderHistory();
  }

  function updateCalculator(){
    const cost=Number($('#calcCost').value||0), margin=Number($('#calcMargin').value||0)/100;
    const price=cost>0&&margin>=0&&margin<1?cost/(1-margin):0;
    $('#calcPrice').textContent=money(price);
    $('#calcHint').textContent=cost>0?'目标毛利率 '+Number($('#calcMargin').value||0).toFixed(0)+'% · 成本 '+money(cost):'先录入供应商报价或采购记录';
  }
  $('#calcCost').addEventListener('input',updateCalculator);
  $('#calcMargin').addEventListener('input',updateCalculator);
  $('#copyQuoteBtn').addEventListener('click',async()=>{
    if(!current)return;
    const text=current.material.part_number+'\\n参考单价：'+$('#calcPrice').textContent+'\\n数量：请按客户需求确认';
    try{await navigator.clipboard.writeText(text);toast('报价参考已复制');}catch{toast('浏览器没有允许复制');}
  });

  function renderHistory(){
    if(!current)return;
    $$('.tab').forEach(t=>t.classList.toggle('active',t.dataset.tab===activeTab));
    const rows=current[activeTab]||[];
    if(!rows.length){$('#historyTable').innerHTML='<div class="empty">暂无记录</div>';return;}
    if(activeTab==='supplierQuotes'){
      $('#historyTable').innerHTML='<table class="table"><thead><tr><th>日期</th><th>供应商</th><th>数量</th><th>单价</th><th>交期</th><th>条件</th><th>来源 / 备注</th></tr></thead><tbody>'+rows.map(r=>'<tr><td>'+date(r.quoted_at)+'</td><td><strong>'+esc(r.supplier_name||'未知')+'</strong><br>'+esc(r.supplier_channel||'')+'</td><td>'+esc(r.quantity)+'</td><td><strong>'+money(r.unit_price)+'</strong></td><td>'+esc(r.lead_time||'—')+'</td><td>'+(r.tax_included?'<span class="tag">含税</span>':'')+(r.shipping_included?'<span class="tag">含运</span>':'')+'</td><td>'+esc([r.source,r.notes].filter(Boolean).join(' · ')||'—')+'</td></tr>').join('')+'</tbody></table>';
    } else if(activeTab==='purchases'){
      $('#historyTable').innerHTML='<table class="table"><thead><tr><th>日期</th><th>供应商</th><th>数量</th><th>采购单价</th><th>合计</th><th>关联客户</th><th>订单 / 备注</th></tr></thead><tbody>'+rows.map(r=>'<tr><td>'+date(r.purchased_at)+'</td><td><strong>'+esc(r.supplier_name||'未知')+'</strong></td><td>'+esc(r.quantity)+'</td><td><strong>'+money(r.unit_price)+'</strong></td><td>'+money(Number(r.quantity)*Number(r.unit_price))+'</td><td>'+esc(r.customer_name||'—')+'</td><td>'+esc([r.order_ref,r.notes].filter(Boolean).join(' · ')||'—')+'</td></tr>').join('')+'</tbody></table>';
    } else {
      $('#historyTable').innerHTML='<table class="table"><thead><tr><th>日期</th><th>客户</th><th>数量</th><th>销售单价</th><th>当时成本</th><th>毛利率</th><th>状态 / 备注</th></tr></thead><tbody>'+rows.map(r=>{const p=Number(r.unit_price),c=r.cost_unit_price===null?null:Number(r.cost_unit_price),m=c!==null&&p>0?(p-c)/p*100:null;return '<tr><td>'+date(r.quoted_at)+'</td><td><strong>'+esc(r.customer_name||'未记录')+'</strong></td><td>'+esc(r.quantity)+'</td><td><strong>'+money(p)+'</strong></td><td>'+money(c)+'</td><td class="'+(m!==null&&m<0?'negative':'positive')+'">'+(m===null?'—':m.toFixed(1)+'%')+'</td><td><span class="tag">'+esc(r.status==='won'?'已成交':r.status==='lost'?'未成交':'已报价')+'</span>'+esc(r.notes||'')+'</td></tr>'}).join('')+'</tbody></table>';
    }
  }
  $$('.tab').forEach(t=>t.addEventListener('click',()=>{activeTab=t.dataset.tab;renderHistory();}));

  function openDialog(id){
    const d=document.getElementById(id);
    if(!d)return;
    if(['supplierQuoteDialog','purchaseDialog','saleDialog'].includes(id)&&!current){toast('请先打开一个物料');return;}
    if(current){
      $$('input[name="material_id"]',d).forEach(x=>x.value=current.material.id);
      const cost=latestCost();
      if(id==='saleDialog'&&cost!==null)d.querySelector('[name="cost_unit_price"]').value=cost;
    }
    $$('input[type="date"]',d).forEach(x=>{if(!x.value)x.value=today();});
    d.showModal();
  }
  $('[data-open]').forEach(b=>b.addEventListener('click',()=>{
    if(b.dataset.open==='materialDialog'){
      const f=$('#materialForm');f.reset();f.elements.id.value='';$('#materialDialogTitle').textContent='新增物料';formStatus(f,'');
    }
    openDialog(b.dataset.open);
  }));
  $$('[data-open-record]').forEach(b=>b.addEventListener('click',()=>openDialog(b.dataset.openRecord)));
  $$('[data-close]').forEach(b=>b.addEventListener('click',()=>b.closest('dialog').close()));
  $$('dialog').forEach(d=>d.addEventListener('click',e=>{if(e.target===d)d.close();}));

  $('#backBtn').addEventListener('click',()=>{
    detailArea.hidden=true;$('#listArea').hidden=false;current=null;$('#searchInput').focus();window.scrollTo({top:0,behavior:'smooth'});
  });

  $('#editMaterialBtn').addEventListener('click',()=>{
    if(!current)return;
    const f=$('#materialForm'),m=current.material;
    ['id','part_number','brand','name','category','specs','aliases','alternatives','source_url','notes'].forEach(k=>{if(f.elements[k])f.elements[k].value=m[k]||'';});
    $('#materialDialogTitle').textContent='编辑物料';
    openDialog('materialDialog');
  });

  function formDataObject(form){
    const fd=new FormData(form), out={};
    for(const [k,v] of fd.entries()) out[k]=v;
    $$('input[type="checkbox"]',form).forEach(x=>out[x.name]=x.checked);
    return out;
  }
  function formStatus(form,message=''){ $('.form-status',form).textContent=message; }

  $('#materialForm').addEventListener('submit',async e=>{
    e.preventDefault();const f=e.currentTarget,data=formDataObject(f);formStatus(f,'');
    try{
      const id=data.id;
      if(id)await api('materials/'+encodeURIComponent(id),{method:'PUT',body:data});
      else await api('materials',{method:'POST',body:data});
      f.reset(); f.elements.id.value=''; $('#materialDialogTitle').textContent='新增物料'; f.closest('dialog').close();
      toast(id?'物料已更新':'物料已建立'); await loadDashboard(); await search($('#searchInput').value.trim());
      if(id)await openMaterial(id);
    }catch(err){formStatus(f,err.message);}
  });

  $('#supplierForm').addEventListener('submit',async e=>{
    e.preventDefault();const f=e.currentTarget;formStatus(f,'');
    try{await api('suppliers',{method:'POST',body:formDataObject(f)});f.reset();f.closest('dialog').close();toast('供应商已保存');await loadLookups();await loadDashboard();}catch(err){formStatus(f,err.message);}
  });

  $('#customerForm').addEventListener('submit',async e=>{
    e.preventDefault();const f=e.currentTarget;formStatus(f,'');
    try{await api('customers',{method:'POST',body:formDataObject(f)});f.reset();f.closest('dialog').close();toast('客户已保存');await loadLookups();}catch(err){formStatus(f,err.message);}
  });

  async function submitRecord(form,path,message){
    formStatus(form,'');
    try{
      await api(path,{method:'POST',body:formDataObject(form)});
      const materialId=current.material.id;
      form.reset(); form.closest('dialog').close(); toast(message);
      await Promise.all([loadDashboard(),openMaterial(materialId)]);
    }catch(err){formStatus(form,err.message);}
  }
  $('#supplierQuoteForm').addEventListener('submit',e=>{e.preventDefault();submitRecord(e.currentTarget,'supplier-quotes','供应商报价已记录');});
  $('#purchaseForm').addEventListener('submit',e=>{e.preventDefault();submitRecord(e.currentTarget,'purchases','采购记录已保存');});
  $('#saleForm').addEventListener('submit',e=>{e.preventDefault();submitRecord(e.currentTarget,'sales','销售记录已保存');});

  boot();
})();
</script>
</body>
</html>
