---
import Base from '../layouts/Base.astro';import {getCollection} from 'astro:content';import {categories} from '../data/site';
const records=[...categories.map(c=>({title:c.name,description:c.desc,url:`/products/${c.slug}/`,kind:'产品分类'})),...(await getCollection('products')).map(p=>({title:p.data.title,description:p.data.description,url:`/products/${p.data.category}/${p.id}/`,kind:'选型资料'})),...(await getCollection('knowledge')).map(p=>({title:p.data.title,description:p.data.description,url:`/knowledge/${p.id}/`,kind:'技术资料'}))];
---
<Base title="搜索产品与技术资料" noindex={true} crumbs={[{name:'搜索',url:'/search/'}]}><section class="page-intro"><div class="wrap"><p class="eyebrow">SEARCH</p><h1>查找你的需求</h1><p>输入产品名称或关键词，例如“导轨”“图纸”“联轴器”。</p></div></section><section class="section"><div class="wrap"><form class="search-input" role="search"><input id="query" name="q" type="search" aria-label="搜索产品与资料" placeholder="搜索产品与技术资料" maxlength="100"/><button class="button" type="submit">搜索</button></form><p class="search-count" role="status" id="count">共 {records.length} 项</p><div class="card-list" id="results">{records.map(r=><a class="product-card" data-search={`${r.title} ${r.description}`} href={r.url}><p class="eyebrow">{r.kind}</p><h2>{r.title}</h2><p>{r.description}</p></a>)}</div><p class="empty" id="empty" hidden>没有找到匹配内容。试试更短的关键词，或<a class="text-link" href="/rfq/">直接整理询价需求</a>。</p></div></section><script>const input=document.querySelector<HTMLInputElement>('#query')!;const cards=[...document.querySelectorAll<HTMLElement>('[data-search]')];function search(){const q=input.value.trim().toLocaleLowerCase();let count=0;for(const card of cards){const show=(card.dataset.search||'').toLocaleLowerCase().includes(q);card.hidden=!show;if(show)count++;}document.querySelector('#count')!.textContent=`找到 ${count} 项`;document.querySelector<HTMLElement>('#empty')!.hidden=count>0;}input.value=new URLSearchParams(location.search).get('q')||'';search();input.addEventListener('input',search);document.querySelector('.search-input')?.addEventListener('submit',e=>{e.preventDefault();search();const url=new URL(location.href);input.value.trim()?url.searchParams.set('q',input.value.trim()):url.searchParams.delete('q');history.replaceState({},'',url);});</script></Base>
